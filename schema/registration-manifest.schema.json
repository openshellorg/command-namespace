{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensh.org/schema/command-namespace/v0/registration-manifest.schema.json",
  "title": "Registration manifest",
  "description": "How a tool claims namespace nodes (NS-2, NS-3). PROVISIONAL v0; format JSON (PROVISIONAL).",
  "type": "object",
  "required": ["manifest", "package", "claims"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifest": { "const": 0, "description": "Manifest format version. 0 = provisional." },
    "package": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "publisher": { "type": "string" }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "namespace-node.schema.json" }
    },
    "conflict-policy": {
      "enum": ["refuse", "shadow-with-warning"],
      "default": "refuse",
      "description": "NS-3: never silent. refuse = a second claim is a conflict; shadow-with-warning = ordered shadowing, always reported."
    },
    "signatures": {
      "type": "array",
      "items": { "$ref": "input-signature.schema.json" }
    }
  }
}
