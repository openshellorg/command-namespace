// Example registration manifest (JSON5). Validate with schema/registration-manifest.schema.json
// after parsing: JSON5 parses to the same data model as JSON.
{
  $schema: '../schema/registration-manifest.schema.json',
  manifest: 0,
  package: { id: 'npm', version: '10.9.0', publisher: 'npm, Inc.' },
  'conflict-policy': 'refuse',
  claims: [
    {
      path: 'install/npm',
      kind: 'provider',
      summary: 'Install packages from the npm registry',
      entry: { argv: ['npm'], style: 'strict' },
      tokens: {
        subcommands: ['install', 'ls', 'view', 'search'],
        'contextual-flags': [
          { name: 'npm', role: 'manager' },
          { name: 'project', role: 'scope' },
        ],
        // free flags use the + sigil: +yes, +verbose, ++verbose, +++verbose
        'free-flags': [
          { name: 'yes' },
          { name: 'verbose', levels: { '1': 'info', '2': 'debug', '3': 'trace' } },
        ],
      },
    },
    { path: 'npm', kind: 'alias', target: 'install/npm' }, // short form
  ],
  signatures: [
    {
      signature: 0,
      node: 'install/npm',
      context: { cwd: { use: 'read', when: 'flag:project' }, network: 'required', stdin: 'none' },
      inputs: [{ name: 'package', type: 'package-id', repeat: true }],
    },
  ],
}
